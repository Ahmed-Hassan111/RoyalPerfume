@{
    ViewData["Title"] = "تشخيص الطلبات - أطياب رويال";
    Layout = null;
    var orders = ViewBag.Orders as List<RoyalPerfume.Models.Order> ?? new();
    int total       = (int)(ViewBag.TotalOrders   ?? 0);
    decimal revenue = (decimal)(ViewBag.TotalRevenue  ?? 0m);
    int todayOrd    = (int)(ViewBag.TodayOrders   ?? 0);
    decimal todayRev= (decimal)(ViewBag.TodayRevenue  ?? 0m);
    int cashOrd     = (int)(ViewBag.CashOrders    ?? 0);
    int instOrd     = (int)(ViewBag.InstapayOrders?? 0);
    int confOrd     = (int)(ViewBag.ConfirmedOrders?? 0);
    int pendOrd     = (int)(ViewBag.PendingOrders  ?? 0);
    int shipOrd     = (int)(ViewBag.ShippedOrders  ?? 0);
    int delivOrd    = (int)(ViewBag.DeliveredOrders?? 0);
    var topGov      = ViewBag.TopGov as List<dynamic> ?? new();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --gold:        #c8922a;
            --gold-light:  #e8b84b;
            --gold-glow:   rgba(200,146,42,.25);
            --dark-bg:     #0a0a0f;
            --dark-card:   #111118;
            --dark-card2:  #16161f;
            --dark-border: rgba(255,255,255,.07);
            --text-main:   #f0f0f5;
            --text-muted:  #7a7a9a;
            --green:       #22c55e;
            --blue:        #3b82f6;
            --orange:      #f97316;
            --purple:      #a855f7;
            --red:         #ef4444;
        }

        body {
            background: var(--dark-bg);
            color: var(--text-main);
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
        }

        /* ── TOP BAR ── */
        .topbar {
            background: linear-gradient(135deg, #0d0d15 0%, #13131e 100%);
            border-bottom: 1px solid var(--dark-border);
            padding: 14px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }
        .topbar-brand { display: flex; align-items: center; gap: 12px; }
        .topbar-brand .crown { font-size: 26px; filter: drop-shadow(0 0 8px var(--gold)); }
        .topbar-brand h1 { font-size: 20px; font-weight: 700; color: var(--gold-light); }
        .topbar-brand span { font-size: 12px; color: var(--text-muted); display: block; }
        .topbar-actions { display: flex; gap: 10px; }
        .btn-top {
            padding: 8px 18px; border-radius: 10px; font-family: 'Cairo', sans-serif;
            font-size: 13px; font-weight: 600; cursor: pointer; border: none;
            text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
            transition: all .2s;
        }
        .btn-gold { background: linear-gradient(135deg, var(--gold), var(--gold-light)); color: #000; }
        .btn-gold:hover { transform: translateY(-1px); box-shadow: 0 6px 20px var(--gold-glow); }
        .btn-ghost { background: rgba(255,255,255,.05); color: var(--text-main); border: 1px solid var(--dark-border); }
        .btn-ghost:hover { background: rgba(255,255,255,.1); }

        /* ── MAIN LAYOUT ── */
        .main { max-width: 1400px; margin: 0 auto; padding: 32px 24px 60px; }

        /* ── SECTION TITLE ── */
        .section-title {
            font-size: 13px; font-weight: 600; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 1.5px;
            margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
        }
        .section-title::after {
            content: ''; flex: 1; height: 1px; background: var(--dark-border);
        }

        /* ── KPI GRID ── */
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
        .kpi-card {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            padding: 20px;
            position: relative;
            overflow: hidden;
            transition: transform .2s, box-shadow .2s;
        }
        .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.4); }
        .kpi-card::before {
            content: '';
            position: absolute; top: 0; right: 0;
            width: 80px; height: 80px;
            border-radius: 50%;
            opacity: .08;
            transform: translate(20px,-20px);
        }
        .kpi-card.gold::before   { background: var(--gold); }
        .kpi-card.green::before  { background: var(--green); }
        .kpi-card.blue::before   { background: var(--blue); }
        .kpi-card.orange::before { background: var(--orange); }
        .kpi-card.purple::before { background: var(--purple); }
        .kpi-card.red::before    { background: var(--red); }

        .kpi-icon {
            width: 42px; height: 42px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; margin-bottom: 14px;
        }
        .kpi-card.gold   .kpi-icon { background: rgba(200,146,42,.15); color: var(--gold-light); }
        .kpi-card.green  .kpi-icon { background: rgba(34,197,94,.12);  color: var(--green); }
        .kpi-card.blue   .kpi-icon { background: rgba(59,130,246,.12); color: var(--blue); }
        .kpi-card.orange .kpi-icon { background: rgba(249,115,22,.12); color: var(--orange); }
        .kpi-card.purple .kpi-icon { background: rgba(168,85,247,.12); color: var(--purple); }
        .kpi-card.red    .kpi-icon { background: rgba(239,68,68,.12);  color: var(--red); }

        .kpi-value { font-size: 28px; font-weight: 900; line-height: 1; margin-bottom: 4px; }
        .kpi-card.gold   .kpi-value { color: var(--gold-light); }
        .kpi-card.green  .kpi-value { color: var(--green); }
        .kpi-card.blue   .kpi-value { color: var(--blue); }
        .kpi-card.orange .kpi-value { color: var(--orange); }
        .kpi-card.purple .kpi-value { color: var(--purple); }
        .kpi-card.red    .kpi-value { color: var(--red); }

        .kpi-label { font-size: 12px; color: var(--text-muted); font-weight: 500; }

        /* ── TWO-COL ROW ── */
        .row-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 32px; }
        @@media (max-width: 768px) { .row-2col { grid-template-columns: 1fr; } }

        /* ── PANEL ── */
        .panel {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            padding: 22px;
        }
        .panel-title {
            font-size: 14px; font-weight: 700; color: var(--text-main);
            margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
        }

        /* ── STATUS BARS ── */
        .status-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .status-label { font-size: 13px; color: var(--text-muted); min-width: 100px; }
        .bar-track { flex: 1; height: 8px; border-radius: 99px; background: rgba(255,255,255,.06); overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 99px; transition: width 1s ease; }
        .bar-fill.confirmed { background: linear-gradient(90deg, #22c55e, #4ade80); }
        .bar-fill.pending   { background: linear-gradient(90deg, #f97316, #fb923c); }
        .bar-fill.shipped   { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
        .bar-fill.delivered { background: linear-gradient(90deg, #a855f7, #c084fc); }
        .bar-count { font-size: 13px; font-weight: 700; min-width: 30px; text-align: left; }

        /* ── PAYMENT PIE ── */
        .pay-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
        .pay-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
        .pay-label { font-size: 13px; color: var(--text-muted); flex: 1; }
        .pay-val { font-size: 14px; font-weight: 700; color: var(--text-main); }
        .pay-pct { font-size: 11px; color: var(--text-muted); }

        /* ── TOP GOVS ── */
        .gov-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .gov-rank {
            width: 24px; height: 24px; border-radius: 8px;
            background: rgba(200,146,42,.1); color: var(--gold);
            font-size: 12px; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .gov-name { font-size: 13px; color: var(--text-main); flex: 1; }
        .gov-count { font-size: 13px; font-weight: 700; color: var(--gold-light); }

        /* ── ORDERS TABLE ── */
        .table-panel {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 32px;
        }
        .table-header {
            padding: 20px 24px;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid var(--dark-border);
        }
        .table-header h3 { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
        .search-box {
            background: rgba(255,255,255,.05);
            border: 1px solid var(--dark-border);
            border-radius: 10px;
            padding: 8px 14px;
            color: var(--text-main);
            font-family: 'Cairo', sans-serif;
            font-size: 13px;
            outline: none;
            width: 220px;
            transition: border-color .2s;
        }
        .search-box:focus { border-color: var(--gold); }
        .search-box::placeholder { color: var(--text-muted); }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        thead th {
            padding: 12px 16px;
            font-size: 11px; font-weight: 600; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: .8px;
            background: rgba(255,255,255,.02);
            border-bottom: 1px solid var(--dark-border);
            white-space: nowrap;
            text-align: right;
        }
        tbody tr {
            border-bottom: 1px solid rgba(255,255,255,.03);
            transition: background .15s;
        }
        tbody tr:hover { background: rgba(200,146,42,.04); }
        tbody tr:last-child { border-bottom: none; }
        tbody td {
            padding: 13px 16px;
            font-size: 13px;
            vertical-align: top;
        }

        .order-num {
            font-weight: 700; font-size: 12px;
            color: var(--gold-light);
            background: rgba(200,146,42,.1);
            padding: 3px 8px; border-radius: 6px;
            display: inline-block;
        }
        .badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 600; white-space: nowrap;
        }
        .badge-confirmed   { background: rgba(34,197,94,.12);  color: #4ade80; border: 1px solid rgba(34,197,94,.2); }
        .badge-pending     { background: rgba(249,115,22,.12); color: #fb923c; border: 1px solid rgba(249,115,22,.2); }
        .badge-shipped     { background: rgba(59,130,246,.12); color: #60a5fa; border: 1px solid rgba(59,130,246,.2); }
        .badge-delivered   { background: rgba(168,85,247,.12); color: #c084fc; border: 1px solid rgba(168,85,247,.2); }
        .badge-cash        { background: rgba(34,197,94,.1);  color: #4ade80; }
        .badge-instapay    { background: rgba(59,130,246,.1); color: #60a5fa; }
        .badge-other       { background: rgba(255,255,255,.06); color: #aaa; }

        .price-tag { font-weight: 700; color: var(--gold-light); }
        .date-cell { font-size: 11px; color: var(--text-muted); line-height: 1.6; }
        .items-mini { display: flex; flex-wrap: wrap; gap: 4px; }
        .item-chip {
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 6px; padding: 2px 7px;
            font-size: 11px; color: #ccc;
            white-space: nowrap;
        }
        .empty-row { text-align: center; padding: 48px 16px !important; color: var(--text-muted); }
        .empty-row .emoji { font-size: 40px; display: block; margin-bottom: 10px; }

        /* ── FOOTER ── */
        .diag-footer {
            text-align: center; color: var(--text-muted); font-size: 12px;
            padding: 16px; border-top: 1px solid var(--dark-border);
        }

        /* Animations */
        @@keyframes fadeUp {
            from { opacity:0; transform: translateY(16px); }
            to   { opacity:1; transform: translateY(0); }
        }
        .kpi-card { animation: fadeUp .5s ease both; }
        .kpi-card:nth-child(1)  { animation-delay: .05s; }
        .kpi-card:nth-child(2)  { animation-delay: .10s; }
        .kpi-card:nth-child(3)  { animation-delay: .15s; }
        .kpi-card:nth-child(4)  { animation-delay: .20s; }
        .kpi-card:nth-child(5)  { animation-delay: .25s; }
        .kpi-card:nth-child(6)  { animation-delay: .30s; }
        .kpi-card:nth-child(7)  { animation-delay: .35s; }
        .kpi-card:nth-child(8)  { animation-delay: .40s; }

        .highlight-row { background: rgba(200,146,42,.06) !important; }
    </style>
</head>
<body>

<!-- TOP BAR -->
<header class="topbar">
    <div class="topbar-brand">
        <span class="crown">👑</span>
        <div>
            <h1>أطياب رويال</h1>
            <span>تشخيص الطلبات الشامل</span>
        </div>
    </div>
    <div class="topbar-actions">
        <a href="/Admin/Orders" class="btn-top btn-ghost"><i class="fas fa-list"></i> إدارة الطلبات</a>
        <a href="/Admin" class="btn-top btn-ghost"><i class="fas fa-tachometer-alt"></i> الداشبورد</a>
        <a href="javascript:window.print()" class="btn-top btn-gold"><i class="fas fa-print"></i> طباعة</a>
    </div>
</header>

<div class="main">

    <!-- KPI ROW 1 — Overall -->
    <div class="section-title"><i class="fas fa-chart-bar"></i> الإحصائيات الكلية</div>
    <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit,minmax(175px,1fr)); margin-bottom:32px;">
        <div class="kpi-card gold">
            <div class="kpi-icon"><i class="fas fa-shopping-bag"></i></div>
            <div class="kpi-value">@total</div>
            <div class="kpi-label">إجمالي الطلبات</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-icon"><i class="fas fa-coins"></i></div>
            <div class="kpi-value">@revenue.ToString("N0")</div>
            <div class="kpi-label">إجمالي الإيرادات ج.م</div>
        </div>
        <div class="kpi-card blue">
            <div class="kpi-icon"><i class="fas fa-calendar-day"></i></div>
            <div class="kpi-value">@todayOrd</div>
            <div class="kpi-label">طلبات اليوم</div>
        </div>
        <div class="kpi-card orange">
            <div class="kpi-icon"><i class="fas fa-wallet"></i></div>
            <div class="kpi-value">@todayRev.ToString("N0")</div>
            <div class="kpi-label">إيرادات اليوم ج.م</div>
        </div>
        <div class="kpi-card purple">
            <div class="kpi-icon"><i class="fas fa-money-bill-wave"></i></div>
            <div class="kpi-value">@cashOrd</div>
            <div class="kpi-label">طلبات كاش</div>
        </div>
        <div class="kpi-card blue">
            <div class="kpi-icon"><i class="fas fa-mobile-alt"></i></div>
            <div class="kpi-value">@instOrd</div>
            <div class="kpi-label">طلبات إنستاباي</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-icon"><i class="fas fa-check-circle"></i></div>
            <div class="kpi-value">@confOrd</div>
            <div class="kpi-label">مؤكدة</div>
        </div>
        <div class="kpi-card red">
            <div class="kpi-icon"><i class="fas fa-clock"></i></div>
            <div class="kpi-value">@pendOrd</div>
            <div class="kpi-label">قيد المراجعة</div>
        </div>
    </div>

    <!-- CHARTS ROW -->
    <div class="row-2col">
        <!-- Status Breakdown -->
        <div class="panel">
            <div class="panel-title"><i class="fas fa-chart-pie" style="color:var(--gold)"></i> توزيع حالات الطلبات</div>
            @{
                int safeTotal = total > 0 ? total : 1;
                double confPct  = Math.Round(confOrd  * 100.0 / safeTotal, 1);
                double pendPct  = Math.Round(pendOrd  * 100.0 / safeTotal, 1);
                double shipPct  = Math.Round(shipOrd  * 100.0 / safeTotal, 1);
                double delivPct = Math.Round(delivOrd * 100.0 / safeTotal, 1);
            }
            <div class="status-row">
                <div class="status-label">✅ مؤكد</div>
                <div class="bar-track"><div class="bar-fill confirmed" style="width:@(confPct)%"></div></div>
                <div class="bar-count" style="color:var(--green)">@confOrd</div>
                <div style="font-size:11px;color:var(--text-muted);min-width:40px">@confPct%</div>
            </div>
            <div class="status-row">
                <div class="status-label">⏳ مراجعة</div>
                <div class="bar-track"><div class="bar-fill pending" style="width:@(pendPct)%"></div></div>
                <div class="bar-count" style="color:var(--orange)">@pendOrd</div>
                <div style="font-size:11px;color:var(--text-muted);min-width:40px">@pendPct%</div>
            </div>
            <div class="status-row">
                <div class="status-label">🚚 شحن</div>
                <div class="bar-track"><div class="bar-fill shipped" style="width:@(shipPct)%"></div></div>
                <div class="bar-count" style="color:var(--blue)">@shipOrd</div>
                <div style="font-size:11px;color:var(--text-muted);min-width:40px">@shipPct%</div>
            </div>
            <div class="status-row">
                <div class="status-label">📦 تسليم</div>
                <div class="bar-track"><div class="bar-fill delivered" style="width:@(delivPct)%"></div></div>
                <div class="bar-count" style="color:var(--purple)">@delivOrd</div>
                <div style="font-size:11px;color:var(--text-muted);min-width:40px">@delivPct%</div>
            </div>
        </div>

        <!-- Governorate + Payment -->
        <div style="display:flex;flex-direction:column;gap:16px;">

            <!-- Payment Methods -->
            <div class="panel" style="flex:1;">
                <div class="panel-title"><i class="fas fa-credit-card" style="color:var(--gold)"></i> طرق الدفع</div>
                @{
                    double cashPct = total > 0 ? Math.Round(cashOrd * 100.0 / total, 1) : 0;
                    double instPct = total > 0 ? Math.Round(instOrd * 100.0 / total, 1) : 0;
                }
                <div class="pay-row">
                    <div class="pay-dot" style="background:var(--green)"></div>
                    <div class="pay-label">💵 كاش</div>
                    <div class="pay-val">@cashOrd</div>
                    <div class="pay-pct">@cashPct%</div>
                </div>
                <div class="pay-row">
                    <div class="pay-dot" style="background:var(--blue)"></div>
                    <div class="pay-label">📱 إنستاباي</div>
                    <div class="pay-val">@instOrd</div>
                    <div class="pay-pct">@instPct%</div>
                </div>
                <!-- Mini visual bar -->
                <div style="margin-top:12px;height:10px;border-radius:99px;overflow:hidden;display:flex;gap:2px;">
                    <div style="width:@(cashPct)%;background:linear-gradient(90deg,#22c55e,#4ade80);transition:width 1s;"></div>
                    <div style="width:@(instPct)%;background:linear-gradient(90deg,#3b82f6,#60a5fa);transition:width 1s;"></div>
                </div>
            </div>

            <!-- Top Governorates -->
            @if (topGov.Any())
            {
                <div class="panel" style="flex:1;">
                    <div class="panel-title"><i class="fas fa-map-marker-alt" style="color:var(--gold)"></i> أعلى المحافظات طلباً</div>
                    @for (int i = 0; i < topGov.Count; i++)
                    {
                        var g = topGov[i];
                        <div class="gov-row">
                            <div class="gov-rank">@(i + 1)</div>
                            <div class="gov-name">@g.Name</div>
                            <div class="gov-count">@g.Count طلب</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ORDERS TABLE -->
    <div class="section-title"><i class="fas fa-list-alt"></i> تفاصيل جميع الطلبات (@total طلب)</div>
    <div class="table-panel">
        <div class="table-header">
            <h3><i class="fas fa-receipt" style="color:var(--gold)"></i> سجل الطلبات الكامل</h3>
            <input type="text" class="search-box" id="searchInput" placeholder="🔍 ابحث باسم أو رقم طلب..." oninput="filterOrders()">
        </div>
        <div class="table-wrap">
            <table id="ordersTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>رقم الطلب</th>
                        <th>التاريخ</th>
                        <th>العميل</th>
                        <th>الهاتف</th>
                        <th>المحافظة / المنطقة</th>
                        <th>المنتجات</th>
                        <th>الدفع</th>
                        <th>المجموع الفرعي</th>
                        <th>الخصم</th>
                        <th>الشحن</th>
                        <th>الإجمالي</th>
                        <th>الحالة</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!orders.Any())
                    {
                        <tr>
                            <td colspan="14" class="empty-row">
                                <span class="emoji">📭</span>
                                لا توجد طلبات مسجلة بعد
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNum = 1;
                        @foreach (var o in orders)
                        {
                            var statusClass = o.Status switch {
                                "confirmed"      => "badge-confirmed",
                                "pending_review" => "badge-pending",
                                "pending"        => "badge-pending",
                                "shipped"        => "badge-shipped",
                                "delivered"      => "badge-delivered",
                                _                => "badge-pending"
                            };
                            var statusText = o.Status switch {
                                "confirmed"      => "✅ مؤكد",
                                "pending_review" => "⏳ مراجعة",
                                "pending"        => "⏳ انتظار",
                                "shipped"        => "🚚 شحن",
                                "delivered"      => "📦 تسليم",
                                _                => o.Status
                            };
                            var payBadge = o.PaymentMethod switch {
                                "cash"     => ("badge-cash",    "💵 كاش"),
                                "instapay" => ("badge-instapay","📱 إنستاباي"),
                                _          => ("badge-other",   "💳 أخرى")
                            };
                            bool isToday = o.OrderDate.Date == DateTime.Today;
                            <tr class="@(isToday ? "highlight-row" : "") order-row"
                                data-search="@o.OrderNumber.ToLower() @o.FullName.ToLower() @o.Phone">
                                <td style="color:var(--text-muted);font-size:12px;">@(rowNum++)</td>
                                <td><span class="order-num">@o.OrderNumber</span></td>
                                <td class="date-cell">
                                    @o.OrderDate.ToString("dd/MM/yyyy")<br>
                                    <span style="color:var(--gold);font-size:12px;">@o.OrderDate.ToString("HH:mm")</span>
                                    @if (isToday) { <br><span style="color:var(--green);font-size:10px;">اليوم ✨</span> }
                                </td>
                                <td>
                                    <strong style="color:var(--text-main);">@o.FullName</strong>
                                    @if (!string.IsNullOrWhiteSpace(o.AlternatePhone))
                                    {
                                        <br><span style="font-size:11px;color:var(--text-muted);">📞 @o.AlternatePhone</span>
                                    }
                                </td>
                                <td dir="ltr" style="font-size:13px;color:var(--text-main);">@o.Phone</td>
                                <td>
                                    <span style="color:var(--text-main);">@o.Governorate</span>
                                    @if (!string.IsNullOrWhiteSpace(o.District))
                                    {
                                        <br><span style="font-size:11px;color:var(--text-muted);">@o.District</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(o.Address))
                                    {
                                        <br><span style="font-size:10px;color:var(--text-muted);">📍 @(o.Address.Length > 40 ? o.Address[..40]+"…" : o.Address)</span>
                                    }
                                </td>
                                <td>
                                    <div class="items-mini">
                                        @if (o.Items != null && o.Items.Any())
                                        {
                                            @foreach (var it in o.Items)
                                            {
                                                <span class="item-chip">@it.ProductName ×@it.Quantity</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-muted);font-size:11px;">—</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="badge @payBadge.Item1">@payBadge.Item2</span></td>
                                <td class="price-tag">@o.Subtotal.ToString("N0") ج</td>
                                <td style="color:var(--red);font-weight:600;">
                                    @if (o.Discount > 0) { <span>-@o.Discount.ToString("N0") ج</span> }
                                    else { <span style="color:var(--text-muted);">—</span> }
                                </td>
                                <td style="color:var(--orange);font-size:13px;">
                                    @if (o.ShippingCost > 0) { @($"+{o.ShippingCost:N0} ج") } else { <span style="color:var(--text-muted);">—</span> }
                                </td>
                                <td class="price-tag" style="font-size:15px;">@o.Total.ToString("N0") ج</td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                                <td style="font-size:12px;color:var(--text-muted);max-width:140px;">
                                    @if (!string.IsNullOrWhiteSpace(o.Notes)) { @o.Notes } else { <span>—</span> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="diag-footer">
            آخر تحديث: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") |
            إجمالي الطلبات: <strong style="color:var(--gold)">@total</strong> |
            إجمالي الإيرادات: <strong style="color:var(--green)">@revenue.ToString("N0") ج.م</strong>
        </div>
    </div>
</div>

<script>
function filterOrders() {
    const q = document.getElementById('searchInput').value.toLowerCase().trim();
    document.querySelectorAll('.order-row').forEach(row => {
        const data = row.dataset.search || '';
        row.style.display = data.includes(q) ? '' : 'none';
    });
}

// Animate bars after load
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.bar-fill').forEach(el => {
        const w = el.style.width;
        el.style.width = '0';
        setTimeout(() => el.style.width = w, 200);
    });
});
</script>

</body>
</html>
