@model RoyalPerfume.Models.CheckoutViewModel
@{
    ViewData["Title"] = "إتمام الطلب - أطياب رويال";
    var governorates = new[] {
        "القاهرة", "الجيزة", "الإسكندرية", "الدقهلية", "البحيرة",
        "الشرقية", "المنوفية", "القليوبية", "الغربية", "كفر الشيخ",
        "دمياط", "الإسماعيلية", "السويس", "بورسعيد", "سيناء الشمالية",
        "سيناء الجنوبية", "أسيوط", "قنا", "الأقصر", "أسوان",
        "سوهاج", "المنيا", "بني سويف", "الفيوم", "مطروح", "الوادي الجديد",
        "البحر الأحمر"
    };
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-lock me-3" style="color:var(--gold);"></i>إتمام الطلب</h1>
        <p>أدخل بياناتك لإتمام عملية الشراء بأمان</p>
    </div>
</div>

<section class="checkout-section">
    <div class="container">
        <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="checkoutForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <!-- Left: Forms -->
                <div class="col-lg-8">
                    
                    <!-- Step 1: Customer Info -->
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <div class="checkout-step-num">1</div>
                            <div>
                                <h3>بيانات الاستلام والتوصيل الدقيق</h3>
                                <p style="color: var(--text-muted); font-size: 14px; margin: 0;">أدخل بياناتك الصحيحة لضمان وصول طلبك</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="FullName">الاسم الكامل *</label>
                                <input type="text" id="FullName" name="FullName" class="form-control" 
                                       value="@Model.FullName" placeholder="مثال: أحمد محمد السيد" required>
                                <span asp-validation-for="FullName" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Phone">رقم الهاتف *</label>
                                <div style="position: relative;">
                                    <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;">🇪🇬 +20</span>
                                    <input type="tel" id="Phone" name="Phone" class="form-control" 
                                           value="@Model.Phone" placeholder="01XXXXXXXXX" required
                                           style="padding-right: 80px;">
                                </div>
                                <span asp-validation-for="Phone" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="AlternatePhone">رقم هاتف بديل (اختياري)</label>
                                <input type="tel" id="AlternatePhone" name="AlternatePhone" class="form-control" 
                                       value="@Model.AlternatePhone" placeholder="رقم احتياطي">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="Governorate">المحافظة *</label>
                                <select id="Governorate" name="Governorate" class="form-select" required>
                                    <option value="">اختر المحافظة</option>
                                    @foreach (var gov in governorates)
                                    {
                                        <option value="@gov" selected="@(Model.Governorate == gov ? "selected" : null)">@gov</option>
                                    }
                                </select>
                                <span asp-validation-for="Governorate" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="District">المنطقة / الحي</label>
                                <input type="text" id="District" name="District" class="form-control" 
                                       value="@Model.District" placeholder="مثال: مدينة نصر - التجمع الخامس">
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="Address">العنوان التفصيلي الدقيق *</label>
                                <textarea id="Address" name="Address" class="form-control" rows="3"
                                          placeholder="مثال: شارع التسعين الشمالي - عمارة 142 - الدور الثالث - شقة 6 - بجوار بنك مصر" required>@Model.Address</textarea>
                                <span asp-validation-for="Address" class="text-danger" style="font-size:12px;"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="Notes">ملاحظات إضافية (اختياري)</label>
                                <textarea id="Notes" name="Notes" class="form-control" rows="2"
                                          placeholder="مثال: الاتصال قبل الوصول بـ 15 دقيقة - وتوفير إمكانية تجربة العطر قبل الاستلام">@Model.Notes</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Payment -->
                    <div class="checkout-card">
                        <div class="checkout-card-header">
                            <div class="checkout-step-num">2</div>
                            <div>
                                <h3>طريقة الدفع</h3>
                                <p style="color: var(--text-muted); font-size: 14px; margin: 0;">الدفع كاش عند الاستلام</p>
                            </div>
                        </div>

                        <input type="hidden" name="PaymentMethod" value="cash">

                        <div style="display: flex; align-items: center; gap: 16px; background: linear-gradient(135deg, rgba(200,146,42,0.1), rgba(200,146,42,0.04)); border: 2px solid rgba(200,146,42,0.4); border-radius: 16px; padding: 20px 24px;">
                            <div style="font-size: 40px;">💵</div>
                            <div>
                                <h5 style="color: var(--brown-medium); font-weight: 700; margin: 0 0 4px;">الدفع عند الاستلام (كاش)</h5>
                                <p style="color: var(--text-muted); font-size: 14px; margin: 0;">ادفع لما المندوب يوصل عندك — 100% آمن ومضمون 🔒</p>
                            </div>
                            <span class="payment-badge recommended" style="margin-right: auto;">الوحيد المتاح</span>
                        </div>
                    </div>

                    <!-- Guarantee -->
                    <div style="background: linear-gradient(135deg, rgba(200,146,42,0.08), rgba(200,146,42,0.03)); border: 1px solid rgba(200,146,42,0.3); border-radius: 16px; padding: 24px;">
                        <h5 style="color: var(--brown-medium); font-weight: 700; margin-bottom: 12px;">
                            <i class="fas fa-shield-alt me-2" style="color: var(--gold);"></i>
                            ضمان أطياب رويال الذهبي
                        </h5>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary);">
                                <i class="fas fa-check-circle" style="color: var(--gold);"></i>
                                ضمان الأصالة 100%
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary);">
                                <i class="fas fa-check-circle" style="color: var(--gold);"></i>
                                إرجاع واسترداد خلال 14 يوم
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary);">
                                <i class="fas fa-check-circle" style="color: var(--gold);"></i>
                                توصيل سريع وآمن
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary);">
                                <i class="fas fa-check-circle" style="color: var(--gold);"></i>
                                دعم عملاء 12 ساعة
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Order Summary -->
                <div class="col-lg-4">
                    <div class="order-summary-card">
                        <div class="order-summary-header">
                            <i class="fas fa-shopping-bag me-2"></i>ملخص المقتنيات
                            <span style="background: rgba(200,146,42,0.2); border-radius: 50px; padding: 2px 10px; font-size: 13px; margin-right: 8px;">@Model.Cart.Items.Count عطور</span>
                        </div>
                        <div class="order-summary-body">
                            <!-- Items -->
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="checkout-summary-item">
                                    <img src="@item.ProductImage" alt="@item.ProductName" class="checkout-summary-img">
                                    <div style="flex: 1;">
                                        <div class="checkout-item-name">@item.ProductName</div>
                                        <div class="checkout-item-qty">@item.Volume | الكمية: @item.Quantity</div>
                                    </div>
                                    <span class="checkout-item-price">@item.TotalPrice.ToString("N0") ج.م</span>
                                </div>
                            }

                            <div style="border-top: 2px solid var(--border-color); margin: 16px 0;"></div>
                            
                            <div class="summary-row">
                                <span>المجموع الفرعي</span>
                                <span class="amount-gold">@Model.Cart.Subtotal.ToString("N0") ج.م</span>
                            </div>
                            @if (Model.Cart.Discount > 0)
                            {
                                <div class="summary-row" style="color: var(--success);">
                                    <span>خصم الكوبون</span>
                                    <span>- @Model.Cart.Discount.ToString("N0") ج.م</span>
                                </div>
                            }
                            <div class="summary-row">
                                <span>الشحن</span>
                                <span class="amount-free">مجاني 🎁</span>
                            </div>
                            <div class="summary-row total">
                                <span>الإجمالي للدفع</span>
                                <span style="color: var(--gold-dark);">@Model.Cart.Total.ToString("N0") ج.م</span>
                            </div>

                            <!-- Place Order Button -->
                            <button type="submit" class="btn-place-order" id="placeOrderBtn">
                                <i class="fas fa-lock"></i>
                                تأكيد الطلب — الدفع عند الاستلام
                                <i class="fas fa-arrow-left"></i>
                            </button>

                            <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 14px; color: var(--text-muted); font-size: 13px;">
                                <i class="fas fa-shipping-fast" style="color: var(--gold);"></i>
                                توصيل خلال 48-72 ساعة
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<a href="https://wa.me/@(_cfg["Contact:WhatsApp"])" target="_blank" class="whatsapp-float">
    <i class="fab fa-whatsapp"></i>
</a>

@section Scripts {
<script>
document.getElementById('checkoutForm').addEventListener('submit', function() {
    const btn = document.getElementById('placeOrderBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري تأكيد الطلب...';
});
</script>
}
