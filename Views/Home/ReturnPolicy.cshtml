@{
    ViewData["Title"] = "سياسة الاسترجاع والاستبدال - أطياب رويال";
}

<!-- Page Hero -->
<div class="page-hero" style="padding: 70px 0 50px; background: linear-gradient(135deg, #0a0a0f 0%, #1a1205 50%, #0a0a0f 100%); position:relative; overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%, rgba(200,146,42,0.12) 0%, transparent 70%);pointer-events:none;"></div>
    <div class="container text-center" style="position:relative;z-index:1;">
        <div style="display:inline-flex;align-items:center;justify-content:center;width:72px;height:72px;background:rgba(200,146,42,0.12);border:1px solid rgba(200,146,42,0.3);border-radius:50%;margin-bottom:20px;">
            <i class="fas fa-shield-alt" style="font-size:28px;color:#c8922a;"></i>
        </div>
        <h1 style="font-family:'Tajawal',sans-serif;font-size:clamp(26px,5vw,40px);font-weight:800;color:#fff;margin-bottom:12px;">
            سياسة الاسترجاع والاستبدال
        </h1>
        <p style="color:#a08040;font-size:16px;max-width:560px;margin:0 auto;line-height:1.8;">
            نلتزم بتقديم أعلى مستوى من الخدمة — تعرّف على حقوقك وشروط الاسترجاع بكل وضوح وشفافية
        </p>
    </div>
</div>

<!-- Main Content -->
<section style="padding: 60px 0 80px; background:#0f0f14;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">

                <!-- ⚠️ Important Notice -->
                <div style="background:linear-gradient(135deg,rgba(220,38,38,0.08),rgba(220,38,38,0.03));border:1px solid rgba(220,38,38,0.3);border-radius:16px;padding:24px 28px;margin-bottom:36px;display:flex;gap:16px;align-items:flex-start;">
                    <div style="flex-shrink:0;width:44px;height:44px;background:rgba(220,38,38,0.12);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-exclamation-triangle" style="color:#ef4444;font-size:18px;"></i>
                    </div>
                    <div>
                        <h3 style="color:#ef4444;font-size:17px;font-weight:700;margin-bottom:8px;font-family:'Tajawal',sans-serif;">
                            ⚠️ تنبيه هام — العطور المفتوحة لا تُسترجع
                        </h3>
                        <p style="color:#c0a0a0;font-size:14px;line-height:1.8;margin:0;">
                            نظراً لطبيعة منتجات العطور الفاخرة وحرصاً على صحة وسلامة جميع عملائنا،
                            <strong style="color:#fca5a5;">لا يُقبل استرجاع أي عطر بعد فتح الختم الأصلي أو إزالة غلاف العبوة</strong>.
                            هذا الشرط معمول به على مستوى جميع متاجر العطور المحترفة عالمياً وفقاً لمعايير السلامة الصحية والذوق العام.
                        </p>
                    </div>
                </div>

                <!-- ✅ Accepted Returns -->
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(200,146,42,0.15);border-radius:16px;padding:32px;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;">
                        <div style="width:48px;height:48px;background:rgba(34,197,94,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas fa-check-circle" style="color:#22c55e;font-size:20px;"></i>
                        </div>
                        <h2 style="color:#c8922a;font-size:19px;font-weight:700;margin:0;font-family:'Tajawal',sans-serif;">
                            الحالات التي يُقبل فيها الاسترجاع أو الاستبدال
                        </h2>
                    </div>
                    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-check" style="color:#22c55e;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">المنتج لم يُفتح إطلاقاً</strong> — الغلاف والختم الأصلي (Cellophane أو شريط الأمان) سليم تماماً دون أي تعديل.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-check" style="color:#22c55e;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">المنتج وصل تالفاً أو معيباً</strong> — كسر في الزجاجة، تسرّب ظاهر، أو عطل في رأس الرش ناتج عن الشحن.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-check" style="color:#22c55e;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">وصل منتج مختلف عن الطلب</strong> — تسلّمت صنفاً أو حجماً غير الذي اخترته.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-check" style="color:#22c55e;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">خلال 14 يوماً</strong> من تاريخ الاستلام الفعلي، مع الاحتفاظ بالفاتورة وجميع محتويات الطرد الأصلية.</span>
                        </li>
                    </ul>
                </div>

                <!-- ❌ Rejected Returns -->
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(200,146,42,0.15);border-radius:16px;padding:32px;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;">
                        <div style="width:48px;height:48px;background:rgba(239,68,68,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas fa-times-circle" style="color:#ef4444;font-size:20px;"></i>
                        </div>
                        <h2 style="color:#c8922a;font-size:19px;font-weight:700;margin:0;font-family:'Tajawal',sans-serif;">
                            الحالات التي لا يُقبل فيها الاسترجاع
                        </h2>
                    </div>
                    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-times" style="color:#ef4444;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">العبوة مفتوحة أو الختم مكسور</strong> — بمجرد فتح العطر يُعتبر مستخدماً ولا يمكن إعادته لأسباب صحية.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-times" style="color:#ef4444;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">عدم الإعجاب بالرائحة بعد الفتح</strong> — لذلك ننصح بالتواصل معنا قبل الشراء للاستشارة الكاملة حول الرائحة.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-times" style="color:#ef4444;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">مرور أكثر من 14 يوماً</strong> على تاريخ استلام الطلب.</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-times" style="color:#ef4444;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">غياب الفاتورة أو ملحقات المنتج</strong> — يجب إعادة المنتج بكامل مشتملاته (علبة، غلاف، هدية إن وجدت).</span>
                        </li>
                        <li style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-times" style="color:#ef4444;margin-top:5px;flex-shrink:0;"></i>
                            <span style="color:#c8bfb0;line-height:1.75;"><strong style="color:#fff;">عطور التجربة (Miniature/Sample)</strong> — لا تُسترجع نظراً لطبيعتها.</span>
                        </li>
                    </ul>
                </div>

                <!-- 📋 Return Steps -->
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(200,146,42,0.15);border-radius:16px;padding:32px;margin-bottom:20px;">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;">
                        <div style="width:48px;height:48px;background:rgba(200,146,42,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas fa-list-ol" style="color:#c8922a;font-size:20px;"></i>
                        </div>
                        <h2 style="color:#c8922a;font-size:19px;font-weight:700;margin:0;font-family:'Tajawal',sans-serif;">
                            خطوات طلب الاسترجاع أو الاستبدال
                        </h2>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:20px;">
                        @{
                            var steps = new[] {
                                ("1","fas fa-comments","تواصل معنا فوراً","أرسل رسالة واتساب أو اتصل بنا خلال 14 يوماً من الاستلام، مع ذكر رقم الطلب واسمك."),
                                ("2","fas fa-camera","أرسل صوراً واضحة","صوّر المنتج من جميع الجهات موضحاً حالة الختم والعبوة والعيب إن وجد."),
                                ("3","fas fa-user-check","مراجعة الطلب","يراجع فريقنا طلبك خلال 24 ساعة ويتواصل معك للتأكيد وإخبارك بالخطوة التالية."),
                                ("4","fas fa-truck","استلام المنتج","في حالات العيب أو الخطأ نُرسل مندوباً لاستلام المنتج على حسابنا."),
                                ("5","fas fa-money-bill-wave","استرداد المبلغ أو الاستبدال","يُردّ المبلغ كاملاً خلال 3–7 أيام عمل أو نُرسل البديل فوراً حسب اختيارك.")
                            };
                        }
                        @foreach (var (num, icon, title, desc) in steps)
                        {
                            <div style="display:flex;gap:16px;align-items:flex-start;">
                                <div style="width:38px;height:38px;background:rgba(200,146,42,0.12);border:1px solid rgba(200,146,42,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:800;color:#c8922a;font-size:14px;font-family:'Tajawal',sans-serif;">
                                    @num
                                </div>
                                <div style="flex:1;">
                                    <div style="color:#fff;font-weight:700;margin-bottom:5px;font-family:'Tajawal',sans-serif;">
                                        <i class="@icon" style="color:#c8922a;margin-left:7px;font-size:13px;"></i>@title
                                    </div>
                                    <div style="color:#8a807a;font-size:14px;line-height:1.75;">@desc</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 🏆 Authenticity Guarantee -->
                <div style="background:linear-gradient(135deg,rgba(200,146,42,0.07),rgba(200,146,42,0.02));border:1px solid rgba(200,146,42,0.25);border-radius:16px;padding:32px;margin-bottom:40px;">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
                        <div style="width:48px;height:48px;background:rgba(200,146,42,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="fas fa-award" style="color:#c8922a;font-size:20px;"></i>
                        </div>
                        <h2 style="color:#c8922a;font-size:19px;font-weight:700;margin:0;font-family:'Tajawal',sans-serif;">
                            ضمان الأصالة 100%
                        </h2>
                    </div>
                    <p style="color:#c8bfb0;line-height:1.9;margin:0;font-size:15px;">
                        جميع عطورنا <strong style="color:#c8922a;">أصلية 100%</strong> ومستوردة مباشرة من الموردين المعتمدين.
                        في الحالة النادرة التي يثبت فيها عدم الأصالة بموجب تقرير معتمد، نضمن لك
                        <strong style="color:#fff;">استرداداً كاملاً للمبلغ + تعويضاً</strong>.
                        نحن نفخر بسمعتنا ولن نتنازل عن جودتنا أبداً.
                    </p>
                </div>

                <!-- CTA -->
                <div style="text-align:center;">
                    <p style="color:#7a706a;margin-bottom:22px;font-size:15px;">هل لديك استفسار أو تريد تقديم طلب استرجاع؟ تواصل معنا الآن</p>
                    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
                        <a href="https://wa.me/@(_cfg["Contact:WhatsApp"])?text=مرحباً،%20أريد%20الاستفسار%20عن%20سياسة%20الاسترجاع"
                           target="_blank"
                           style="display:inline-flex;align-items:center;gap:9px;background:#25d366;color:#fff;padding:13px 30px;border-radius:50px;font-family:'Tajawal',sans-serif;font-weight:700;font-size:15px;text-decoration:none;transition:opacity .2s;box-shadow:0 4px 20px rgba(37,211,102,0.25);"
                           onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                            <i class="fab fa-whatsapp" style="font-size:19px;"></i>
                            واتساب
                        </a>
                        <a href="tel:@(_cfg["Contact:Phone"])"
                           style="display:inline-flex;align-items:center;gap:9px;background:rgba(200,146,42,0.1);color:#c8922a;border:1px solid rgba(200,146,42,0.35);padding:13px 30px;border-radius:50px;font-family:'Tajawal',sans-serif;font-weight:700;font-size:15px;text-decoration:none;transition:opacity .2s;"
                           onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">
                            <i class="fas fa-phone-alt"></i>
                            @(_cfg["Contact:Phone"])
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- WhatsApp Float -->
<a href="https://wa.me/@(_cfg["Contact:WhatsApp"])" target="_blank" class="whatsapp-float">
    <i class="fab fa-whatsapp"></i>
</a>
