@model List<RoyalPerfume.Models.Product>
@{
    ViewData["Title"] = "كل العطور - أطياب رويال";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="fas fa-spray-can me-3" style="color:var(--gold);"></i>مجموعة العطور</h1>
        <p>اكتشف أرقى العطور العالمية والعربية</p>
    </div>
</div>

<section style="padding: 40px 0 80px;">
    <div class="container">
        <!-- Filter Bar -->
        <div class="filter-bar">
            <span style="color: var(--text-muted); font-size: 14px; font-weight: 600;">تصفية:</span>
            <a href="@Url.Action("Index", "Products")" 
               class="filter-btn @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")">
                الكل (@Model.Count)
            </a>
            @foreach (var cat in categories)
            {
                <a href="@Url.Action("Index", "Products", new { category = cat })" 
                   class="filter-btn @(selectedCategory == cat ? "active" : "")">
                    @cat
                </a>
            }
        </div>

        <!-- Products Grid -->
        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="product-card">
                            <div class="product-image-wrap">
                                <img src="@product.ImageUrl" alt="@product.NameAr" loading="lazy">
                                @if (product.IsOnSale && product.OldPrice > 0)
                                {
                                    <span class="product-badge">خصم @product.DiscountPercent%</span>
                                }
                                @if (product.IsFeatured)
                                {
                                    <span class="product-badge badge-featured">⭐ مميز</span>
                                }
                                <div class="product-actions">
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@product.Id">
                                        <button type="submit" class="btn-quick-add">
                                            <i class="fas fa-cart-plus"></i> أضف للسلة
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="product-info">
                                <div class="product-category">@product.Category | @product.Concentration</div>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                                    <h3 class="product-name">@product.NameAr</h3>
                                </a>
                                <div class="product-volume">@product.Volume</div>
                                <div class="product-rating">
                                    <span class="stars">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            <i class="@(i < (int)product.Rating ? "fas" : "far") fa-star"></i>
                                        }
                                    </span>
                                    <span class="rating-text">(@product.ReviewCount تقييم)</span>
                                </div>
                                <div class="product-price-wrap">
                                    <span class="price-current">@product.Price.ToString("N0") ج.م</span>
                                    @if (product.OldPrice > 0)
                                    {
                                        <span class="price-old">@product.OldPrice.ToString("N0") ج.م</span>
                                    }
                                </div>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="productId" value="@product.Id">
                                    <button type="submit" class="btn-add-cart">
                                        <i class="fas fa-shopping-bag"></i>
                                        أضف للسلة
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-cart">
                <div class="empty-cart-icon">🔍</div>
                <h3>لا توجد منتجات في هذه الفئة</h3>
                <p>جرب فئة أخرى أو تصفح كل العطور</p>
                <a asp-controller="Products" asp-action="Index" class="btn-hero-primary" style="display:inline-flex;">
                    <i class="fas fa-th-large"></i>
                    كل العطور
                </a>
            </div>
        }
    </div>
</section>

<a href="https://wa.me/@(_cfg["Contact:WhatsApp"])" target="_blank" class="whatsapp-float">
    <i class="fab fa-whatsapp"></i>
</a>
